rules_version = '2';

// Slice 3: ownership + tenancy rules, no custom claims (rules-only v1).
// Model (brief §3/§5): self-serve parents/students, tenantId "default" for
// everyone until branded tenants exist; superadmin by verified email.
// plans/ and alerts/ docs carry denormalized householdId + tenantId so their
// rules never need a child→household join; children/ carries householdId and
// membership is checked with one get() on the household doc.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return isSignedIn() &&
        request.auth.token.email == 'zymer4him@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isMemberOf(householdId) {
      let h = get(/databases/$(database)/documents/households/$(householdId)).data;
      return isSignedIn() &&
        (request.auth.uid in h.parentUids || request.auth.uid in h.studentUids);
    }

    // users/{uid} — role and tenantId are immutable from the client.
    match /users/{uid} {
      allow read: if isSelf(uid) || isSuperadmin();
      allow create: if isSelf(uid)
        && request.resource.data.role in ['parent', 'student']
        && request.resource.data.tenantId == 'default';
      allow update: if isSuperadmin()
        || (isSelf(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.tenantId == resource.data.tenantId);
      allow delete: if isSuperadmin();
    }

    // A student redeeming a claim code may append EXACTLY themselves to
    // studentUids. Validity chain: their claims/{uid} doc names a code, and
    // claimCodes/{code} (parent-created) must point at this household.
    function isValidSelfClaim(householdId) {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentUids'])
        && request.resource.data.studentUids.size() == resource.data.studentUids.size() + 1
        && request.resource.data.studentUids.hasAll(resource.data.studentUids)
        && request.auth.uid in request.resource.data.studentUids
        && !(request.auth.uid in resource.data.studentUids)
        && get(/databases/$(database)/documents/claimCodes/$(get(/databases/$(database)/documents/claims/$(request.auth.uid)).data.code)).data.householdId == householdId;
    }

    // households/{householdId} — readable/writable by members only.
    match /households/{householdId} {
      allow read: if isSuperadmin()
        || (isSignedIn()
          && (request.auth.uid in resource.data.parentUids
            || request.auth.uid in resource.data.studentUids));
      allow create: if isSignedIn()
        && request.resource.data.tenantId == 'default'
        && request.resource.data.keys().hasAll(['parentUids', 'studentUids', 'tenantId'])
        && (request.auth.uid in request.resource.data.parentUids
          || request.auth.uid in request.resource.data.studentUids);
      allow update: if isSuperadmin()
        || (isSignedIn()
          && (request.auth.uid in resource.data.parentUids
            || request.auth.uid in resource.data.studentUids)
          && request.resource.data.tenantId == resource.data.tenantId)
        || isValidSelfClaim(householdId);
      allow delete: if isSuperadmin();
    }

    // claimCodes/{code} — parent-minted invitations for a student to claim a
    // child's card. The code itself is the secret; reading requires knowing
    // it (no listing). Post-login only, optional (brief §3).
    match /claimCodes/{code} {
      allow get: if isSignedIn();
      allow list: if isSuperadmin();
      allow create: if isSignedIn()
        && request.resource.data.tenantId == 'default'
        && isMemberOf(request.resource.data.householdId);
      // Single-use: the redeeming student stamps usedByUid exactly once.
      allow update: if isSignedIn()
        && !('usedByUid' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedByUid'])
        && request.resource.data.usedByUid == request.auth.uid;
      allow delete: if isSuperadmin() || isMemberOf(resource.data.householdId);
    }

    // claims/{uid} — the student's own claim record naming the code they
    // redeemed; referenced by isValidSelfClaim.
    match /claims/{uid} {
      allow read, create, update: if isSelf(uid) || isSuperadmin();
      allow delete: if isSuperadmin();
    }

    // children/{childId} — parent-managed by default; any household member
    // can read/update. householdId and tenantId are immutable.
    match /children/{childId} {
      allow read: if isSuperadmin() || isMemberOf(resource.data.householdId);
      allow create: if isSignedIn()
        && request.resource.data.tenantId == 'default'
        && isMemberOf(request.resource.data.householdId);
      allow update: if isSuperadmin()
        || (isMemberOf(resource.data.householdId)
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.tenantId == resource.data.tenantId);
      allow delete: if isSuperadmin() || isMemberOf(resource.data.householdId);
    }

    // profiles/{householdId} — parent financial bands; members only.
    match /profiles/{householdId} {
      allow read, write: if isSuperadmin() || isMemberOf(householdId);
    }

    // plans/{childId} — generated milestone plan. Carries denormalized
    // householdId + tenantId (checked on create, immutable after).
    match /plans/{childId} {
      allow read: if isSuperadmin() || isMemberOf(resource.data.householdId);
      allow create: if isSignedIn()
        && request.resource.data.tenantId == 'default'
        && isMemberOf(request.resource.data.householdId);
      allow update: if isSuperadmin()
        || (isMemberOf(resource.data.householdId)
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.tenantId == resource.data.tenantId);
      allow delete: if isSuperadmin() || isMemberOf(resource.data.householdId);
    }

    // alerts/{childId} — card deltas; same denormalized shape as plans.
    match /alerts/{childId} {
      allow read: if isSuperadmin() || isMemberOf(resource.data.householdId);
      allow create: if isSignedIn()
        && request.resource.data.tenantId == 'default'
        && isMemberOf(request.resource.data.householdId);
      allow update: if isSuperadmin()
        || (isMemberOf(resource.data.householdId)
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.tenantId == resource.data.tenantId);
      allow delete: if isSuperadmin() || isMemberOf(resource.data.householdId);
    }

    // recommendations/{householdId} — affordability+fit output (later slice).
    match /recommendations/{householdId} {
      allow read, write: if isSuperadmin() || isMemberOf(householdId);
    }

    // Everything else: denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
